# ─── OpenAI 호환 API ────────────────────────────────────────────────────
# OpenAI, Google Gemini (via LiteLLM), Anthropic 등 OpenAI 호환 엔드포인트
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key-here

# ─── 모델 설정 ──────────────────────────────────────────────────────────
# 메타데이터 추출, 번역, RAG 챗봇에 사용되는 모델
TRANSLATION_MODEL=gpt-4o

# 번역 파라미터 (선택, 기본값 사용 가능)
# TRANSLATION_MAX_TOKENS=8192
# TRANSLATION_TEMPERATURE=0.3

# ─── 웹 검색 보강 (선택) ────────────────────────────────────────────────
# Brave Search API로 논문 메타데이터 보강 (venue, DOI, year, URL)
# 없으면 자동 건너뜀 — https://brave.com/search/api/ 에서 무료 키 발급
BRAVE_SEARCH_API_KEY=

# ─── 로그인 인증 ────────────────────────────────────────────────────────
LOGIN_ID=admin
LOGIN_PASSWORD=changeme

# JWT signing secret (REQUIRED — startup fails if empty/short/placeholder).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ─── 쿠키 보안 (HTTPS 운영 시 true) ───────────────────────────────────────
# 로컬 HTTP(예: 8090 직접 노출)에서는 false 유지. HTTPS 리버스 프록시 뒤라면 true 권장.
COOKIE_SECURE=false